# Local Docker Compose only. Never reuse these credentials in a shared environment.
COMPOSE_PROJECT_NAME=excellent-calendar-cloud
POSTGRES_DB=excellent_calendar
POSTGRES_USER=excellent_calendar
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Required for the "app" Compose profile (the api profile refuses to start without it).
# Generate one with: openssl rand -base64 48
# EXCELLENT_CALENDAR_SECURITY_JWT_SECRET=

# Browser CORS is denied by default. Mobile HTTPS clients do not need CORS.
# EXCELLENT_CALENDAR_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional real SMTP for verification emails (identity challenges). Leave HOST empty to keep the
# dev console inbox (api,local logs "[mail.dev] ... code=...") or the code-free warning otherwise.
# Use the mailbox's SMTP authorization code (授权码), not the login password.
#   QQ 邮箱:   host=smtp.qq.com          port=465 ssl=true
#   163 邮箱:  host=smtp.163.com         port=465 ssl=true
#   Outlook:   host=smtp.office365.com   port=587 start-tls=true
#   Gmail:     host=smtp.gmail.com       port=587 start-tls=true  (App Password)
# EXCELLENT_CALENDAR_MAIL_HOST=
# EXCELLENT_CALENDAR_MAIL_PORT=587
# EXCELLENT_CALENDAR_MAIL_USERNAME=
# EXCELLENT_CALENDAR_MAIL_PASSWORD=
# EXCELLENT_CALENDAR_MAIL_FROM=
# EXCELLENT_CALENDAR_MAIL_START_TLS=true
# EXCELLENT_CALENDAR_MAIL_SSL=false
