        "open_operation_id"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "workspace_kind": {
          "const": "account"
        },
        "account_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "session_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storage_format_version": {
          "const": 6
        },
        "native_contract_version": {
          "const": 3
        },
        "storage_directory": {
