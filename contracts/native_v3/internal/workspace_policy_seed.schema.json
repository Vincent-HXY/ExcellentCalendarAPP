{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal/workspace_policy_seed.schema.json",
  "title": "SyncV1 workspace_policy_seed",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8.3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sync_enabled",
        "sync_policy_revision",
        "clear_operation_id"
      ],
      "properties": {
        "kind": {
          "const": "genesis"
        },
        "sync_enabled": {
          "const": true
        },
        "sync_policy_revision": {
          "const": 0
        },
        "clear_operation_id": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sync_enabled",
        "sync_policy_revision",
        "clear_operation_id",
        "workspace_id",
        "device_id",
        "session_generation",
        "resulting_sync_transport_generation",
        "lifecycle_seed_hash"
      ],
      "properties": {
        "kind": {
          "const": "clear_rebuild"
        },
        "sync_enabled": {
          "type": "boolean"
        },
        "sync_policy_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "clear_operation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "workspace_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "device_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "session_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resulting_sync_transport_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lifecycle_seed_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ],
  "x-exposure": "kotlin_jni_cpp_only"
}
