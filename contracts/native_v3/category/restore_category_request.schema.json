{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/category/restore_category_request.schema.json",
  "title": "SyncV1 restore_category_request",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "expected_active_route_revision",
    "id",
    "expected_native_state_revision",
    "candidate"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_native_state_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "color",
        "icon",
        "sort_order"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": ".*\\S.*"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "color": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "sort_order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Nullable compatibility projection constrained to the exact cross-language JSON integer range 0..9007199254740991; category.list orders null after every integer."
        }
      }
    }
  }
}
