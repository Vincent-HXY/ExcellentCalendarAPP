{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/common/native_result.schema.json",
  "title": "SyncV1 native_result",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,8,12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "data",
    "error",
    "contract_version",
    "request_id"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "$ref": "https://excellent-calendar.local/contracts/native_v3/common/native_error.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "contract_version": {
      "const": 3
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        },
        "data": {
          "type": "null"
        },
        "error": {
          "$ref": "https://excellent-calendar.local/contracts/native_v3/common/native_error.schema.json"
        }
      }
    }
  ]
}
