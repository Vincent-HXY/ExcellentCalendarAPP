{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/reminder_create_request_payload.schema.json",
  "title": "SyncV1 reminder_create_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "description": "Creates an ordinary one-time Reminder with UUIDv4 identity. Recurring Event reminders are created only by the Event workflow from templates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_type",
    "target_id",
    "methods",
    "is_enabled",
    "source"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "event",
        "habit",
        "anniversary"
      ]
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "remind_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "advance_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ring",
          "popup",
          "wechat"
        ]
      }
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_enabled": {
      "type": "boolean",
      "const": true
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "auto",
        "ai_extraction",
        "sync",
        "import",
        "wechat"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "methods": {
            "const": [
              "ring"
            ]
          }
        },
        "required": [
          "methods"
        ]
      },
      "then": {
        "properties": {
          "target_type": {
            "const": "event"
          }
        }
      }
    }
  ],
  "oneOf": [
    {
      "required": [
        "remind_at"
      ],
      "properties": {
        "remind_at": {
          "type": "string",
          "format": "date-time"
        },
        "advance_minutes": {
          "type": "null"
        }
      }
    },
    {
      "required": [
        "advance_minutes"
      ],
      "properties": {
        "remind_at": {
          "type": "null"
        },
        "advance_minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  ]
}
