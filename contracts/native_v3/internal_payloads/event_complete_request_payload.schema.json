{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/event_complete_request_payload.schema.json",
  "title": "SyncV1 event_complete_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "description": "Completes one non-recurring Event. Recurring series and occurrences use their explicit v2 methods. The completion time comes from the C++ Clock.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "auto",
        "ai_extraction",
        "sync",
        "import",
        "wechat"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
