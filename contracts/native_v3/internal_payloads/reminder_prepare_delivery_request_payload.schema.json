{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/reminder_prepare_delivery_request_payload.schema.json",
  "title": "SyncV1 reminder_prepare_delivery_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "description": "Starts or idempotently reuses one prepared delivery attempt. C++ remains the identity and membership authority. For ordinary Reminder delivery, Kotlin may supply the current device IANA timezone; C++ requires it when the resolved target is Habit so an elapsed local-date occurrence is atomically expired before display. Existing Event/Anniversary callers may omit it. For anniversary_catch_up, Kotlin echoes only the delivery_id exposed by the frozen RecoveryBatch group; C++ reloads and verifies the group before returning immutable content. Successor projection remains deferred to finalize_delivery with the then-current device timezone.",
  "x-timezone-policy": "timezone is an optional compatibility extension on the shared request and is required by C++ only after kind=reminder resolves to target_type=habit. Recovery membership is already frozen; Anniversary successor projection occurs only during finalize_delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "reminder_id",
    "recovery_batch_id",
    "delivery_id",
    "method",
    "expected_remind_at"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "reminder",
        "recovery_summary",
        "anniversary_catch_up"
      ]
    },
    "reminder_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "recovery_batch_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "delivery_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "method": {
      "type": "string",
      "enum": [
        "ring",
        "popup"
      ]
    },
    "expected_remind_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "x-format": "iana-timezone",
      "description": "Current device timezone. Optional for backward-compatible Event/Anniversary delivery; required by C++ when reminder_id resolves to a Habit Reminder."
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "reminder"
        },
        "reminder_id": {
          "type": "string",
          "format": "uuid"
        },
        "recovery_batch_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "delivery_id": {
          "type": "null"
        },
        "expected_remind_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "recovery_summary"
        },
        "reminder_id": {
          "type": "null"
        },
        "recovery_batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "delivery_id": {
          "type": "null"
        },
        "method": {
          "const": "popup"
        },
        "expected_remind_at": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "anniversary_catch_up"
        },
        "reminder_id": {
          "type": "null"
        },
        "recovery_batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "delivery_id": {
          "type": "string",
          "format": "uuid"
        },
        "method": {
          "const": "popup"
        },
        "expected_remind_at": {
          "type": "null"
        }
      }
    }
  ]
}
