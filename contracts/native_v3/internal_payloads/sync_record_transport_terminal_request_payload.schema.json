{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/sync_record_transport_terminal_request_payload.schema.json",
  "title": "SyncV1 sync_record_transport_terminal_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "runtime_instance_id",
    "device_id",
    "session_generation",
    "sync_transport_generation",
    "code",
    "error_envelope_sha256"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtime_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sync_transport_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "code": {
      "enum": [
        "SYNC_PROTOCOL_VERSION_UNSUPPORTED",
        "SYNC_SEQUENCE_REPLAY_MISMATCH",
        "SYNC_SEQUENCE_ROUTE_MISMATCH",
        "SYNC_CLIENT_SEQUENCE_EXHAUSTED",
        "SYNC_SERVER_SEQUENCE_EXHAUSTED",
        "SYNC_CURSOR_INVALID",
        "SYNC_CURSOR_ACCOUNT_MISMATCH",
        "SYNC_CURSOR_DEVICE_MISMATCH",
        "SYNC_OUTBOX_CORRUPTED",
        "SYNC_APPLY_FAILED"
      ]
    },
    "error_envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
