{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/reminder_list_schedulable_request_payload.schema.json",
  "title": "SyncV1 reminder_list_schedulable_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "description": "Internal scheduler query. C++ returns enabled, non-deleted pending reminders, plus scheduled status only when include_scheduled is true. Permanent failed reminders are terminal and never retried here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supported_methods"
  ],
  "properties": {
    "from_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "to_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remind_at",
            "reminder_id"
          ],
          "properties": {
            "remind_at": {
              "type": "string",
              "format": "date-time"
            },
            "reminder_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ],
      "description": "Exclusive keyset cursor ordered by (remind_at, reminder_id)."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 500
    },
    "include_scheduled": {
      "type": "boolean",
      "default": false
    },
    "supported_methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "popup",
          "ring"
        ]
      }
    }
  }
}
