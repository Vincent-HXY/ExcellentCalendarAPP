{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/reminder_list_schedulable_response_payload.schema.json",
  "title": "SyncV1 reminder_list_schedulable_response_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4",
  "description": "Bounded result for Android alarm registration. has_more prevents a truncated batch from being mistaken for a complete scan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "selected_count",
    "has_more",
    "next_cursor",
    "unsupported_reminder_ids"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/reminder/reminder_response.schema.json"
      }
    },
    "selected_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remind_at",
            "reminder_id"
          ],
          "properties": {
            "remind_at": {
              "type": "string",
              "format": "date-time"
            },
            "reminder_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "unsupported_reminder_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Eligible reminder IDs excluded because none of their methods are supported by the caller."
    }
  }
}
