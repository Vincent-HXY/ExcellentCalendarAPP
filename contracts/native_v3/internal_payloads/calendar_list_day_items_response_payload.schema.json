{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/calendar_list_day_items_response_payload.schema.json",
  "title": "SyncV1 calendar_list_day_items_response_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4",
  "description": "One section-specific page tied to one immutable Calendar View snapshot. The section discriminates the item schema. A terminal page has next_cursor=null; a non-terminal page has at least one item and a strictly advancing opaque cursor.",
  "x-calendar-view-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "timezone",
    "section",
    "snapshot_token",
    "page_size",
    "items",
    "has_more",
    "next_cursor"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "section": {
      "type": "string",
      "enum": [
        "event",
        "habit",
        "anniversary"
      ]
    },
    "snapshot_token": {
      "type": "string",
      "pattern": "^calsnap1\\.[A-Za-z0-9_-]{20,512}$",
      "maxLength": 521
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "items": {
      "type": "array",
      "maxItems": 100
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^calcur1\\.[A-Za-z0-9_-]{20,2048}$",
      "maxLength": 2056
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "section": {
              "const": "event"
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/calendar/calendar_event_item.schema.json"
              }
            }
          }
        },
        {
          "properties": {
            "section": {
              "const": "habit"
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "https://excellent-calendar.local/contracts/calendar/calendar_habit_item.schema.json"
              }
            }
          }
        },
        {
          "properties": {
            "section": {
              "const": "anniversary"
            },
            "items": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "https://excellent-calendar.local/contracts/calendar/calendar_anniversary_item.schema.json"
              }
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "has_more": {
              "const": true
            },
            "next_cursor": {
              "type": "string",
              "pattern": "^calcur1\\.[A-Za-z0-9_-]{20,2048}$"
            },
            "items": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "has_more": {
              "const": false
            },
            "next_cursor": {
              "type": "null"
            }
          }
        }
      ]
    }
  ]
}
