{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/habit_clear_check_in_response_payload.schema.json",
  "title": "SyncV1 habit_clear_check_in_response_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "integrated",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "description": "Internal atomic set/clear result. check_in=null means the final logical state is cleared. Replayed notification actions return the same final state with idempotent_replay=true.",
  "x-habit-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_saved",
    "check_in",
    "daily_status",
    "statistics",
    "reminder_settings",
    "schedule_reconciliation_required",
    "idempotent_replay"
  ],
  "properties": {
    "data_saved": {
      "const": true
    },
    "check_in": {
      "oneOf": [
        {
          "$ref": "https://excellent-calendar.local/contracts/habit/habit_check_in_response.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "daily_status": {
      "$ref": "https://excellent-calendar.local/contracts/habit/habit_daily_status_response.schema.json"
    },
    "statistics": {
      "$ref": "https://excellent-calendar.local/contracts/habit/habit_statistics_response.schema.json"
    },
    "reminder_settings": {
      "$ref": "https://excellent-calendar.local/contracts/habit/habit_reminder_settings_response.schema.json"
    },
    "schedule_reconciliation_required": {
      "type": "boolean"
    },
    "idempotent_replay": {
      "type": "boolean"
    }
  }
}
