{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/habit_detail_request_payload.schema.json",
  "title": "SyncV1 habit_detail_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "integrated",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "description": "Loads one non-deleted Habit aggregate and a bounded first history page.",
  "x-habit-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "timezone",
    "history_page_size"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "x-format": "iana-timezone"
    },
    "history_page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    }
  }
}
