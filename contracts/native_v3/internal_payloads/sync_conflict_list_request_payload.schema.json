{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/sync_conflict_list_request_payload.schema.json",
  "title": "SyncV1 sync_conflict_list_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.5,8,12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "status",
    "target_type",
    "page_token",
    "page_size"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": [
        "unresolved",
        "resolved",
        "all"
      ]
    },
    "target_type": {
      "oneOf": [
        {
          "enum": [
            "category",
            "event",
            "event_recurrence",
            "event_occurrence_state",
            "anniversary",
            "anniversary_recurrence",
            "habit",
            "habit_recurrence",
            "habit_check_in",
            "reminder_intent"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "page_token": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 2048,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$"
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
