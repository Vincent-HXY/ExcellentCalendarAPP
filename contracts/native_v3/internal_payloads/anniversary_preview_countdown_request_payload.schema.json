{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/anniversary_preview_countdown_request_payload.schema.json",
  "title": "SyncV1 anniversary_preview_countdown_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "description": "Calculates a countdown before persistence from only the facts needed by the calculator. recurrence must reflect the form's current yearly-repeat switch. lunar is accepted so the operation can return ANNIVERSARY_CALENDAR_UNSUPPORTED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "calendar_type",
    "recurrence",
    "timezone"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "calendar_type": {
      "type": "string",
      "enum": [
        "solar",
        "lunar"
      ]
    },
    "recurrence": {
      "oneOf": [
        {
          "$ref": "https://excellent-calendar.local/contracts/anniversary/anniversary_recurrence_rule_input.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA timezone used to derive today's local date."
    }
  }
}
