{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/calendar_list_day_items_request_payload.schema.json",
  "title": "SyncV1 calendar_list_day_items_request_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4",
  "description": "Lists one typed Calendar section for one local date against the exact snapshot returned by calendar.range_summary. cursor=null starts the section; continuation cursors bind every query field, sort revision, complete last key, and snapshot token.",
  "x-calendar-view-revision": 1,
  "x-semantic-errors": {
    "malformed_snapshot_token": "CALENDAR_SNAPSHOT_INVALID",
    "changed_snapshot_generation": "CALENDAR_SNAPSHOT_EXPIRED",
    "malformed_cursor": "CALENDAR_CURSOR_INVALID",
    "cursor_query_mismatch": "CALENDAR_CURSOR_QUERY_MISMATCH",
    "invalid_timezone": "TIMEZONE_ID_INVALID"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "section",
    "snapshot_token",
    "cursor",
    "page_size",
    "workspace_timezone",
    "device_timezone"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "section": {
      "type": "string",
      "enum": [
        "event",
        "habit",
        "anniversary"
      ]
    },
    "snapshot_token": {
      "type": "string",
      "pattern": "^calsnap1\\.[A-Za-z0-9_-]{20,512}$",
      "maxLength": 521
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^calcur1\\.[A-Za-z0-9_-]{20,2048}$",
      "maxLength": 2056
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "workspace_timezone": {
      "type": "null",
      "description": "Core resolves this axis from durable workspace preferences in the query snapshot; callers cannot override it."
    },
    "device_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-format": "iana-timezone",
      "x-owner": "Kotlin OS timezone injection"
    }
  }
}
