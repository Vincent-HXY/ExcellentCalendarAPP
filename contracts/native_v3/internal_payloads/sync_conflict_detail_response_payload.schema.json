{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/internal_payloads/sync_conflict_detail_response_payload.schema.json",
  "title": "SyncV1 sync_conflict_detail_response_payload",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.5,8,12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "runtime_instance_id",
    "summary",
    "conflicting_groups",
    "auto_merged_groups",
    "recovery_candidate",
    "manual_draft",
    "allowed_resolution_modes"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtime_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "summary": {
      "$ref": "https://excellent-calendar.local/contracts/sync/sync_conflict_summary.schema.json"
    },
    "conflicting_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "server_candidate",
          "local_candidate"
        ],
        "properties": {
          "key": {
            "$ref": "https://excellent-calendar.local/contracts/sync/sync_merge_key.schema.json"
          },
          "server_candidate": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "projection"
                ],
                "properties": {
                  "kind": {
                    "const": "value"
                  },
                  "projection": {
                    "$ref": "https://excellent-calendar.local/contracts/sync/sync_field_projection.schema.json"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "deleted"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "absent"
                  }
                }
              }
            ]
          },
          "local_candidate": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "projection"
                ],
                "properties": {
                  "kind": {
                    "const": "value"
                  },
                  "projection": {
                    "$ref": "https://excellent-calendar.local/contracts/sync/sync_field_projection.schema.json"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "deleted"
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "server_candidate": {
                  "properties": {
                    "kind": {
                      "const": "absent"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "key": {
                  "properties": {
                    "target_type": {
                      "enum": [
                        "event_recurrence",
                        "anniversary_recurrence",
                        "habit_recurrence",
                        "reminder_intent"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "auto_merged_groups": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projection",
          "resulting_entity_version",
          "resulting_field_version"
        ],
        "properties": {
          "projection": {
            "$ref": "https://excellent-calendar.local/contracts/sync/sync_field_projection.schema.json"
          },
          "resulting_entity_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "resulting_field_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "recovery_candidate": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://excellent-calendar.local/contracts/sync/v1/sync_fact.schema.json"
            },
            {
              "properties": {
                "target_type": {
                  "enum": [
                    "category",
                    "event",
                    "event_recurrence",
                    "event_occurrence_state",
                    "anniversary",
                    "anniversary_recurrence",
                    "habit",
                    "habit_recurrence",
                    "habit_check_in",
                    "reminder_intent"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "manual_draft": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://excellent-calendar.local/contracts/sync/v1/sync_fact.schema.json"
            },
            {
              "properties": {
                "target_type": {
                  "enum": [
                    "category",
                    "event",
                    "event_recurrence",
                    "event_occurrence_state",
                    "anniversary",
                    "anniversary_recurrence",
                    "habit",
                    "habit_recurrence",
                    "habit_check_in",
                    "reminder_intent"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_resolution_modes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "enum": [
          "keep_local",
          "keep_remote",
          "per_field",
          "manual_edit"
        ]
      }
    }
  }
}
