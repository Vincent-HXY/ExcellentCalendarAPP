{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/business_compat/calendar/calendar_range_summary_response.schema.json",
  "title": "CalendarRangeSummaryResponse",
  "description": "Complete, gap-free ascending day summaries plus the opaque Calendar View snapshot token that must be used by all selected-day section requests accepted into the same Flutter page snapshot.",
  "x-contract-version": 3,
  "x-calendar-view-revision": 1,
  "x-implementation-status": "planned",
  "x-order": [
    "date"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "range_start_date",
    "range_end_date",
    "snapshot_token",
    "days",
    "workspace_timezone",
    "device_timezone"
  ],
  "properties": {
    "range_start_date": {
      "type": "string",
      "format": "date"
    },
    "range_end_date": {
      "type": "string",
      "format": "date"
    },
    "snapshot_token": {
      "type": "string",
      "pattern": "^calsnap1\\.[A-Za-z0-9_-]{20,512}$",
      "maxLength": 521
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 42,
      "items": {
        "$ref": "https://excellent-calendar.local/contracts/calendar/calendar_range_day_summary.schema.json"
      }
    },
    "workspace_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-format": "iana-timezone"
    },
    "device_timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-format": "iana-timezone"
    }
  },
  "x-contract-domain": "native",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4"
}
