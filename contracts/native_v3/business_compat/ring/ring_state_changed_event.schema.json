        "capability_changed",
        "test_changed",
        "session_changed",
        "session_recovered"
      ]
    },
    "state": {
      "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/ring/ring_state_snapshot.schema.json"
    }
  },
  "x-contract-domain": "native",
  "x-implementation-status": "planned",
