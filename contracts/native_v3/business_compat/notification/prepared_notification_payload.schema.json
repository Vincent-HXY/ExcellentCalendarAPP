{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/business_compat/notification/prepared_notification_payload.schema.json",
  "title": "PreparedNotificationPayload",
  "description": "Immutable PendingIntent payload returned by C++. Android adds opened_at only after a tap. Anniversary and Habit reminder branches carry their target-specific occurrence identity but no mutable domain content.",
  "x-contract-version": 3,
  "x-anniversary-reminder-revision": 1,
  "x-habit-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notification_id",
    "delivery_id",
    "delivery_attempt_id",
    "kind",
    "reminder_id",
    "recovery_batch_id",
    "target_type",
    "target_id",
    "occurrence_key",
    "route"
  ],
  "properties": {
    "notification_id": {
      "type": "string",
      "format": "uuid"
    },
    "delivery_id": {
      "type": "string",
      "format": "uuid"
    },
    "delivery_attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "reminder",
        "recovery_summary",
        "anniversary_catch_up"
      ]
    },
    "reminder_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "recovery_batch_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "event",
        "habit",
        "anniversary",
        "reminder_recovery_batch"
      ]
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurrence_key": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "route": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_kind": {
      "enum": [
        "local",
        "account"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "reminder"
        },
        "reminder_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_type": {
          "enum": [
            "event",
            "habit",
            "anniversary"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target_type": {
                "const": "anniversary"
              }
            },
            "required": [
              "target_type"
            ]
          },
          "then": {
            "properties": {
              "occurrence_key": {
                "type": "string",
                "format": "uuid"
              },
              "route": {
                "const": "anniversary.detail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_type": {
                "const": "habit"
              }
            },
            "required": [
              "target_type"
            ]
          },
          "then": {
            "properties": {
              "occurrence_key": {
                "type": "string",
                "format": "uuid"
              },
              "route": {
                "const": "habit.detail"
              },
              "recovery_batch_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "recovery_summary"
        },
        "reminder_id": {
          "type": "null"
        },
        "recovery_batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_type": {
          "const": "reminder_recovery_batch"
        },
        "occurrence_key": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "anniversary_catch_up"
        },
        "reminder_id": {
          "type": "null"
        },
        "recovery_batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_type": {
          "const": "anniversary"
        },
        "occurrence_key": {
          "type": "string",
          "format": "uuid"
        },
        "route": {
          "const": "anniversary.detail"
        }
      }
    }
  ],
  "dependentRequired": {
    "workspace_id": [
      "workspace_kind"
    ],
    "workspace_kind": [
      "workspace_id"
    ]
  },
  "x-contract-domain": "native",
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4"
}
