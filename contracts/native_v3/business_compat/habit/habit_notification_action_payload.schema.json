{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/business_compat/habit/habit_notification_action_payload.schema.json",
  "title": "HabitNotificationActionPayload",
  "description": "Immutable C++-generated Android notification action. action_id is deterministic; the Receiver echoes it to habit.check_in without starting Flutter. Acceptance requires the same active Habit/date/occurrence identity and the same current local date.",
  "x-contract-version": 3,
  "x-habit-revision": 1,
  "x-implementation-status": "planned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "action_type",
    "habit_id",
    "check_date",
    "occurrence_key",
    "reminder_id",
    "delivery_id"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_type": {
      "const": "complete"
    },
    "habit_id": {
      "type": "string",
      "format": "uuid"
    },
    "check_date": {
      "type": "string",
      "format": "date"
    },
    "occurrence_key": {
      "type": "string",
      "format": "uuid"
    },
    "reminder_id": {
      "type": "string",
      "format": "uuid"
    },
    "delivery_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_kind": {
      "enum": [
        "local",
        "account"
      ]
    }
  },
  "dependentRequired": {
    "workspace_id": [
      "workspace_kind"
    ],
    "workspace_kind": [
      "workspace_id"
    ]
  },
  "x-contract-domain": "native",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4"
}
