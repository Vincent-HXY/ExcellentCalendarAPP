{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/business_compat/search/search_section_response.schema.json",
  "title": "SearchSectionResponse",
  "description": "One independently paged typed Search section with an exact total count. Non-terminal pages are non-empty and carry a strictly advancing opaque cursor.",
  "x-contract-version": 3,
  "x-search-contract-revision": 2,
  "x-implementation-status": "planned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_type",
    "items",
    "total_count",
    "has_more",
    "next_cursor"
  ],
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "event",
        "habit",
        "anniversary"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 20
    },
    "total_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^srchcur1\\.[A-Za-z0-9_-]{20,2048}$",
      "maxLength": 2057
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "target_type": {
              "const": "event"
            },
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/search/search_event_item.schema.json"
              }
            }
          }
        },
        {
          "properties": {
            "target_type": {
              "const": "habit"
            },
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "https://excellent-calendar.local/contracts/search/search_habit_item.schema.json"
              }
            }
          }
        },
        {
          "properties": {
            "target_type": {
              "const": "anniversary"
            },
            "items": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "https://excellent-calendar.local/contracts/search/search_anniversary_item.schema.json"
              }
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "has_more": {
              "const": true
            },
            "next_cursor": {
              "type": "string",
              "pattern": "^srchcur1\\.[A-Za-z0-9_-]{20,2048}$"
            },
            "items": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "has_more": {
              "const": false
            },
            "next_cursor": {
              "type": "null"
            }
          }
        }
      ]
    }
  ],
  "x-contract-domain": "native",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4"
}
