          "type": "null"
        },
        "occurrence_start_at": {
          "type": "null"
        },
        "template_key": {
          "type": "null"
        },
        "occurrence_date": {
          "type": "null"
        },
        "advance_days": {
          "type": "null"
        },
        "local_time": {
          "type": "null"
        },
        "timezone_mode": {
          "type": "null"
        },
        "fulfillment_delivery_id": {
          "type": "null"
        },
        "expiration_reason": {
          "enum": [
            "recovery_window_elapsed",
