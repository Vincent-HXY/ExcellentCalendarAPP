{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/business_compat/reminder/prepare_delivery_response.schema.json",
  "title": "PrepareDeliveryResponse",
  "description": "Prepared Notification attempt, exact tap payload, and—only for a Habit reminder—the immutable direct-complete action payload Kotlin must attach.",
  "x-contract-version": 3,
  "x-habit-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notification",
    "tap_payload",
    "idempotent_replay"
  ],
  "properties": {
    "notification": {
      "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/notification/notification_response.schema.json"
    },
    "tap_payload": {
      "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/notification/prepared_notification_payload.schema.json"
    },
    "idempotent_replay": {
      "type": "boolean"
    },
    "habit_action_payload": {
      "oneOf": [
        {
          "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/habit/habit_notification_action_payload.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "notification": {
            "properties": {
              "target_type": {
                "const": "habit"
              }
            },
            "required": [
              "target_type"
            ]
          }
        },
        "required": [
          "notification"
        ]
      },
      "then": {
        "required": [
          "habit_action_payload"
        ],
        "properties": {
          "habit_action_payload": {
            "$ref": "https://excellent-calendar.local/contracts/native_v3/business_compat/habit/habit_notification_action_payload.schema.json"
          }
        }
      },
      "else": {
        "properties": {
          "habit_action_payload": {
            "type": "null"
          }
        }
      }
    }
  ],
  "x-contract-domain": "native",
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/5,6.1,8.4"
}
