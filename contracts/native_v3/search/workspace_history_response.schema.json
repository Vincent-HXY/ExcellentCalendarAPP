{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/search/workspace_history_response.schema.json",
  "title": "SyncV1 workspace_history_response",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "active_route_revision",
    "history_revision",
    "normalized_display_keywords"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "history_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "normalized_display_keywords": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
