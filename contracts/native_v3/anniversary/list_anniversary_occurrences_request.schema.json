{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/anniversary/list_anniversary_occurrences_request.schema.json",
  "title": "ListAnniversaryOccurrencesRequest",
  "description": "Bounded local-date occurrence query. The range is half-open [range_start_date, range_end_date), non-empty, and at most 400 natural days. Empty filter arrays mean no filter. cursor=null starts a query; a non-null opaque cursor must bind the complete filters, range, timezone, ordering key, and a C++ snapshot generation.",
  "x-contract-version": 3,
  "x-anniversary-reminder-revision": 1,
  "x-semantic-errors": {
    "empty_or_reversed_range": "ANNIVERSARY_OCCURRENCE_RANGE_INVALID",
    "more_than_400_days": "ANNIVERSARY_OCCURRENCE_RANGE_TOO_LARGE",
    "duplicate_filter": "ANNIVERSARY_OCCURRENCE_FILTER_INVALID",
    "malformed_cursor": "ANNIVERSARY_OCCURRENCE_CURSOR_INVALID",
    "expired_or_query_mismatched_cursor": "ANNIVERSARY_OCCURRENCE_CURSOR_EXPIRED"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "range_start_date",
    "range_end_date",
    "timezone",
    "category_ids",
    "importance",
    "cursor",
    "page_size"
  ],
  "properties": {
    "range_start_date": {
      "type": "string",
      "format": "date"
    },
    "range_end_date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "category_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "description": "Opaque weak Category reference; preserve exact Unicode, including historical non-UUID values. Null remains distinct from a string."
      }
    },
    "importance": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "unimportant_noturgent",
          "important_noturgent",
          "unimportant_urgent",
          "important_urgent"
        ]
      }
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^annocc1\\.[A-Za-z0-9_-]{20,2048}$"
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-native-compatibility-revision": "anniversary_opaque_category_v1"
}
