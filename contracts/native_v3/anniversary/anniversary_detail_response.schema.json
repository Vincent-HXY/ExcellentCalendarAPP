{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/native_v3/anniversary/anniversary_detail_response.schema.json",
  "title": "AnniversaryDetailResponse",
  "description": "C++ detail aggregate for the current active solar Anniversary. recurrence is null exactly when anniversary.recurrence_id is null; otherwise it is the matching active yearly rule. reminder_settings exposes configuration and a reconciliation hint without platform permission, Alarm, journal, or delivery-history details.",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anniversary",
    "recurrence",
    "countdown",
    "reminder_settings"
  ],
  "properties": {
    "anniversary": {
      "$ref": "https://excellent-calendar.local/contracts/native_v3/anniversary/anniversary_response.schema.json"
    },
    "recurrence": {
      "description": "Matching active yearly rule, or null for a one-time Anniversary.",
      "oneOf": [
        {
          "$ref": "https://excellent-calendar.local/contracts/anniversary/anniversary_recurrence_response.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "countdown": {
      "$ref": "https://excellent-calendar.local/contracts/anniversary/anniversary_countdown_response.schema.json"
    },
    "reminder_settings": {
      "$ref": "https://excellent-calendar.local/contracts/anniversary/anniversary_reminder_settings_response.schema.json"
    }
  },
  "allOf": [
    {
      "properties": {
        "anniversary": {
          "properties": {
            "calendar_type": {
              "const": "solar"
            },
            "deleted_at": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "anniversary": {
              "properties": {
                "recurrence_id": {
                  "type": "null"
                }
              }
            },
            "recurrence": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "anniversary": {
              "properties": {
                "recurrence_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "recurrence": {
              "$ref": "https://excellent-calendar.local/contracts/anniversary/anniversary_recurrence_response.schema.json"
            }
          }
        }
      ]
    }
  ],
  "x-release-status": "planned",
  "x-native-compatibility-revision": "anniversary_opaque_category_v1"
}
