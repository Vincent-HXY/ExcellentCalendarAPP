{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/backend_sync_v1/user/current_user_response.schema.json",
  "title": "SyncV1 current_user_response",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/3,8.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account",
    "profile",
    "preferences",
    "account_profile_revision",
    "preferences_revision",
    "legacy_locale"
  ],
  "properties": {
    "account": {
      "$ref": "https://excellent-calendar.local/contracts/user/user_account_response.schema.json"
    },
    "profile": {
      "$ref": "https://excellent-calendar.local/contracts/user/user_profile_response.schema.json"
    },
    "preferences": {
      "$ref": "https://excellent-calendar.local/contracts/sync/v1/user_preferences_fact.schema.json"
    },
    "account_profile_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "preferences_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "legacy_locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 35,
      "readOnly": true,
      "description": "Historical read/audit only; new registration is zh-CN. Never a portable preference or update field."
    }
  },
  "x-compatibility-revision": "sync-v1"
}
