{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/auth/password_reset_request.schema.json",
  "title": "PasswordResetRequest",
  "description": "Requests a password reset without revealing whether the email is registered.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["email"],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    }
  },
  "examples": [
    {
      "email": "user@example.com"
    }
  ]
}
