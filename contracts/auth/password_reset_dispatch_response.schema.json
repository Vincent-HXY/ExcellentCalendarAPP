{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/auth/password_reset_dispatch_response.schema.json",
  "title": "PasswordResetDispatchResponse",
  "description": "Enumeration-resistant response returned for both registered and unregistered emails.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "resend_available_at"],
  "properties": {
    "accepted": {
      "type": "boolean",
      "const": true
    },
    "resend_available_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "examples": [
    {
      "accepted": true,
      "resend_available_at": "2026-08-01T01:01:00Z"
    }
  ]
}
