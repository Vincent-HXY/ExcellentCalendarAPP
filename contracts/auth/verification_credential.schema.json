{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/auth/verification_credential.schema.json",
  "title": "VerificationCredential",
  "description": "Exactly one user-supplied credential for an email action challenge.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_type", "code"],
      "properties": {
        "credential_type": {
          "type": "string",
          "const": "code"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_type", "link_token"],
      "properties": {
        "credential_type": {
          "type": "string",
          "const": "link_token"
        },
        "link_token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        }
      }
    }
  ],
  "examples": [
    {
      "credential_type": "code",
      "code": "123456"
    }
  ]
}
