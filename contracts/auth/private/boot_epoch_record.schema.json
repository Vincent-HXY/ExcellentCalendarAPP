{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/auth/private/boot_epoch_record.schema.json",
  "title": "SyncV1 boot_epoch_record",
  "x-contract-domain": "android_private",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "observed_boot_count",
        "boot_id",
        "last_elapsed_realtime_ms"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "const": "global_boot_count"
        },
        "observed_boot_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "boot_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "last_elapsed_realtime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "boot_id",
        "last_elapsed_realtime_ms"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "const": "process_only"
        },
        "boot_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "last_elapsed_realtime_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  ],
  "x-sensitive": true,
  "x-exposure": "kotlin_local_only_never_HTTP_MethodChannel_EventChannel_or_JNI"
}
