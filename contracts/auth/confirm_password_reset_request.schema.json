{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/auth/confirm_password_reset_request.schema.json",
  "title": "ConfirmPasswordResetRequest",
  "description": "Consumes a password-reset credential, sets a new password, and revokes every session.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["email", "credential", "new_password"],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "credential": {
      "$ref": "./verification_credential.schema.json"
    },
    "new_password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "writeOnly": true
    }
  },
  "examples": [
    {
      "email": "user@example.com",
      "credential": {
        "credential_type": "code",
        "code": "123456"
      },
      "new_password": "new-example-password"
    }
  ]
}
