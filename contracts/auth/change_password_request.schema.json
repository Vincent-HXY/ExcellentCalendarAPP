{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/auth/change_password_request.schema.json",
  "title": "ChangePasswordRequest",
  "description": "Changes the authenticated user's password, revokes other sessions, and rotates the current one.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["current_password", "new_password"],
  "properties": {
    "current_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "writeOnly": true
    },
    "new_password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "writeOnly": true
    }
  },
  "examples": [
    {
      "current_password": "current-example-password",
      "new_password": "new-example-password"
    }
  ]
}
