{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/anniversary/anniversary_reminder_template_response.schema.json",
  "title": "AnniversaryReminderTemplateResponse",
  "description": "Persisted Anniversary reminder template projection. timezone_mode and method are identity fields and are fixed in V1.",
  "x-contract-version": 2,
  "x-anniversary-reminder-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["template_key", "advance_days", "local_time", "timezone_mode", "method", "is_enabled"],
  "properties": {
    "template_key": {"type": "string", "format": "uuid"},
    "advance_days": {"type": "integer", "minimum": 0, "maximum": 365},
    "local_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "timezone_mode": {"const": "follow_device"},
    "method": {"const": "popup"},
    "is_enabled": {"type": "boolean"}
  }
}
