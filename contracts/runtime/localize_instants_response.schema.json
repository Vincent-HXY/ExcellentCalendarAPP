{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/runtime/localize_instants_response.schema.json",
  "title": "LocalizeInstantsResponse",
  "description": "Ordered, all-or-nothing localizations for one IANA timezone.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["timezone", "items"],
  "properties": {
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {"$ref": "./localized_instant.schema.json"}
    }
  }
}
