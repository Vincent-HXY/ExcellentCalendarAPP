{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/runtime/initialize_runtime_request.schema.json",
  "title": "InitializeRuntimeRequest",
  "description": "Internal Kotlin-to-C++ initialization request. Kotlin resolves both private directories; Flutter must not provide filesystem paths.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["storage_directory", "tzdb_directory"],
  "properties": {
    "storage_directory": {
      "type": "string",
      "minLength": 1
    },
    "tzdb_directory": {
      "type": "string",
      "minLength": 1
    }
  }
}
