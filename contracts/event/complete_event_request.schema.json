{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/event/complete_event_request.schema.json",
  "title": "CompleteEventRequest",
  "description": "Completes one non-recurring Event. Recurring series and occurrences use their explicit v2 methods. The completion time comes from the C++ Clock.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "source"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "source": {
      "type": "string",
      "enum": ["manual", "auto", "ai_extraction", "sync", "import", "wechat"]
    },
    "note": {"type": ["string", "null"]}
  }
}
