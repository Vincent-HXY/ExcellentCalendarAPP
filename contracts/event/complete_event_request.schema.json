{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/event/complete_event_request.schema.json",
  "title": "CompleteEventRequest",
  "description": "Input payload for completing a single event or one occurrence of a recurring event.",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "completed_at",
    "source"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "auto",
        "ai_extraction",
        "sync",
        "import",
        "wechat"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
