{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/event/reopen_event_request.schema.json",
  "title": "ReopenEventRequest",
  "description": "Input payload for reopening a single event or removing the completed state from one recurring event occurrence.",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
