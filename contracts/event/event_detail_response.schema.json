      "resolved_category_deleted_at": "2026-08-11T10:00:00Z",
      "valid": false
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event",
    "recurrence",
    "reminders",
    "category"
  ],
  "properties": {
    "event": {
      "$ref": "./event_response.schema.json"
    },
    "recurrence": {
      "description": "The Event recurrence rule, or null for a non-recurring Event.",
      "oneOf": [
        {
          "$ref": "../recurrence/recurrence_response.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "reminders": {
      "type": "array",
      "description": "Current non-deleted Reminder tasks associated with this Event. For a recurring Event this is the current rolling set, not an infinite expansion.",
      "items": {
        "$ref": "../reminder/reminder_response.schema.json"
      }
    },
    "category": {
      "description": "The active Category whose id equals event.category_id. It is null for an unclassified Event and also for a dangling or soft-deleted weak reference; those latter cases do not clear or rewrite event.category_id.",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "../category/category_response.schema.json"
            },
            {
              "properties": {
                "deleted_at": {
                  "type": "null"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "properties": {
              "category_id": {
                "type": "null"
              }
            },
            "required": [
              "category_id"
            ]
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "type": "object"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "event": {
            "properties": {
              "category_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "category_id"
            ]
          }
        }
      }
    }
  ],
