{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/event/event_detail_response.schema.json",
  "title": "EventDetailResponse",
  "description": "Detail-page aggregate response containing Event plus optional related Recurrence, Reminders, and the currently resolvable active Category projection. The Event keeps its original category_id even when the Category projection is null.",
  "x-contract-version": 2,
  "x-category-resolution-invariants": [
    "When event.category_id is null, category must be null (unclassified).",
    "When event.category_id is non-null and resolves to an active Category, category must be that Category and category.id must equal event.category_id.",
    "When event.category_id is non-null but dangling or resolves only to a soft-deleted Category, category must be null and event.category_id must remain unchanged."
  ],
