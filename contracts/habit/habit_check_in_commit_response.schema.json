{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/habit/habit_check_in_commit_response.schema.json",
  "title": "HabitCheckInCommitResponse",
  "description": "Internal atomic set/clear result. check_in=null means the final logical state is cleared. Replayed notification actions return the same final state with idempotent_replay=true.",
  "x-contract-version": 2,
  "x-habit-revision": 1,
  "x-implementation-status": "integrated",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_saved", "check_in", "daily_status", "statistics", "reminder_settings", "schedule_reconciliation_required", "idempotent_replay"],
  "properties": {
    "data_saved": {"const": true},
    "check_in": {"oneOf": [{"$ref": "./habit_check_in_response.schema.json"}, {"type": "null"}]},
    "daily_status": {"$ref": "./habit_daily_status_response.schema.json"},
    "statistics": {"$ref": "./habit_statistics_response.schema.json"},
    "reminder_settings": {"$ref": "./habit_reminder_settings_response.schema.json"},
    "schedule_reconciliation_required": {"type": "boolean"},
    "idempotent_replay": {"type": "boolean"}
  }
}
