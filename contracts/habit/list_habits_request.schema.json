{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/habit/list_habits_request.schema.json",
  "title": "ListHabitsRequest",
  "description": "Lists non-deleted card projections in the current device timezone. Missing filters mean all. Stable server order is lifecycle group, today's status rank, reminder local_time null-last, created_at, id.",
  "x-contract-version": 2,
  "x-habit-revision": 1,
  "x-implementation-status": "integrated",
  "type": "object",
  "additionalProperties": false,
  "required": ["timezone"],
  "properties": {
    "timezone": {"type": "string", "minLength": 1, "x-format": "iana-timezone"},
    "lifecycle_statuses": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "enum": ["upcoming", "active", "completed", "ended_early"]}},
    "category_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "pagination": {"allOf": [
      {"$ref": "../common/pagination_request.schema.json"},
      {"properties": {
        "page": {"maximum": 9007199254740991},
        "page_size": {"maximum": 100},
        "cursor": {"minLength": 1, "maxLength": 512},
        "sort_by": {"type": "null"},
        "sort_direction": {"type": "null"}
      }}
    ], "description": "Habit V1 ordering is fixed by C++; caller-defined sorting is forbidden."}
  }
}
