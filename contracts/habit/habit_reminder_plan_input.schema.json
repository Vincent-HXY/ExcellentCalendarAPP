{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/habit/habit_reminder_plan_input.schema.json",
  "title": "HabitReminderPlanInput",
  "description": "Complete V1 daily popup intent. Disabling stops the chain; changing local_time replaces template identity.",
  "x-contract-version": 2,
  "x-habit-revision": 1,
  "x-implementation-status": "integrated",
  "type": "object",
  "additionalProperties": false,
  "required": ["is_enabled", "local_time", "timezone_mode", "method"],
  "properties": {
    "is_enabled": {"type": "boolean"},
    "local_time": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "timezone_mode": {"const": "follow_device"},
    "method": {"const": "popup"}
  },
  "oneOf": [
    {"properties": {"is_enabled": {"const": true}, "local_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}}},
    {"properties": {"is_enabled": {"const": false}, "local_time": {"type": "null"}}}
  ]
}
