{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/device/method_update_device_settings_response.schema.json",
  "title": "SyncV1 method_update_device_settings_response",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "workspace_id",
    "active_route_revision",
    "local_settings",
    "sync_status"
  ],
  "properties": {
    "disposition": {
      "const": "local_saved"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "local_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receive_reminders",
        "sync_enabled",
        "settings_remote_pending",
        "local_settings_revision"
      ],
      "properties": {
        "receive_reminders": {
          "type": "boolean"
        },
        "sync_enabled": {
          "type": "boolean"
        },
        "settings_remote_pending": {
          "type": "boolean"
        },
        "local_settings_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "sync_status": {
      "$ref": "https://excellent-calendar.local/contracts/sync/sync_status_response.schema.json"
    }
  }
}
