        },
        "workspace_state": {
          "$ref": "https://excellent-calendar.local/contracts/workspace/workspace_state_response.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_outcome",
        "revocation",
        "registration_pending"
