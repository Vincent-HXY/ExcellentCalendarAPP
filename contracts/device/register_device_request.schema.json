{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/device/register_device_request.schema.json",
  "title": "SyncV1 register_device_request",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installation_id",
    "display_name",
    "platform",
    "app_version",
    "protocol_version"
  ],
  "properties": {
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "platform": {
      "const": "android"
    },
    "app_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "protocol_version": {
      "const": 1
    }
  }
}
