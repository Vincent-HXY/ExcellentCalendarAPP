{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/user/user_profile_response.schema.json",
  "title": "UserProfileResponse",
  "description": "Public profile data for the authenticated user.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "username", "display_name", "avatar", "created_at", "updated_at"],
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "username": {
      "type": "string",
      "pattern": "^[a-z0-9_]{3,24}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "avatar": {
      "oneOf": [
        {
          "$ref": "./avatar_info.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "examples": [
    {
      "user_id": "3c00d043-6b7c-4eca-92fd-e22a1a6728f4",
      "username": "calendar_user",
      "display_name": "Calendar User",
      "avatar": null,
      "created_at": "2026-08-01T00:55:00Z",
      "updated_at": "2026-08-01T00:55:00Z"
    }
  ]
}
