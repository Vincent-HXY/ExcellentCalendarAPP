{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/user/update_user_settings_request.schema.json",
  "title": "UpdateUserSettingsRequest",
  "description": "Request payload for updating user-level settings. Fields are optional because this is a partial update contract.",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ]
    },
    "locale": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_reminder_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ring",
          "popup",
          "wechat"
        ]
      }
    },
    "settings": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sync_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
