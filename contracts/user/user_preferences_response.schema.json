{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/user/user_preferences_response.schema.json",
  "title": "UserPreferencesResponse",
  "description": "Stable user preferences returned with the current-user aggregate.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "locale", "timezone", "default_reminder_methods", "settings", "created_at", "updated_at"],
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "maxLength": 35
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "IANA timezone identifier such as Asia/Shanghai."
    },
    "default_reminder_methods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ring", "popup", "wechat"]
      }
    },
    "settings": {
      "$ref": "./user_settings.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "examples": [
    {
      "user_id": "3c00d043-6b7c-4eca-92fd-e22a1a6728f4",
      "locale": "zh-CN",
      "timezone": "Asia/Shanghai",
      "default_reminder_methods": ["popup"],
      "settings": {
        "theme": "system"
      },
      "created_at": "2026-08-01T00:55:00Z",
      "updated_at": "2026-08-01T00:55:00Z"
    }
  ]
}
