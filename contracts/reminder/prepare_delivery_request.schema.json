{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/reminder/prepare_delivery_request.schema.json",
  "title": "PrepareDeliveryRequest",
  "description": "Starts or idempotently reuses one prepared delivery attempt. C++ remains the identity and membership authority. For anniversary_catch_up, Kotlin echoes only the delivery_id exposed by the frozen RecoveryBatch group; C++ reloads and verifies the group before returning immutable content.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "reminder_id", "recovery_batch_id", "delivery_id", "method", "expected_remind_at"],
  "properties": {
    "kind": {"type": "string", "enum": ["reminder", "recovery_summary", "anniversary_catch_up"]},
    "reminder_id": {"type": ["string", "null"], "format": "uuid"},
    "recovery_batch_id": {"type": ["string", "null"], "format": "uuid"},
    "delivery_id": {"type": ["string", "null"], "format": "uuid"},
    "method": {"type": "string", "enum": ["ring", "popup"]},
    "expected_remind_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "oneOf": [
    {
      "properties": {
        "kind": {"const": "reminder"},
        "reminder_id": {"type": "string", "format": "uuid"},
        "recovery_batch_id": {"type": ["string", "null"], "format": "uuid"},
        "delivery_id": {"type": "null"},
        "expected_remind_at": {"type": "string", "format": "date-time"}
      }
    },
    {
      "properties": {
        "kind": {"const": "recovery_summary"},
        "reminder_id": {"type": "null"},
        "recovery_batch_id": {"type": "string", "format": "uuid"},
        "delivery_id": {"type": "null"},
        "method": {"const": "popup"},
        "expected_remind_at": {"type": "null"}
      }
    },
    {
      "properties": {
        "kind": {"const": "anniversary_catch_up"},
        "reminder_id": {"type": "null"},
        "recovery_batch_id": {"type": "string", "format": "uuid"},
        "delivery_id": {"type": "string", "format": "uuid"},
        "method": {"const": "popup"},
        "expected_remind_at": {"type": "null"}
      }
    }
  ]
}
