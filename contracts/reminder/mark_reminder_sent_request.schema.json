{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/reminder/mark_reminder_sent_request.schema.json",
  "title": "MarkReminderSentRequest",
  "description": "Internal Kotlin-to-C++ payload used after Kotlin has triggered and displayed or delivered a reminder.",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "last_triggered_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
