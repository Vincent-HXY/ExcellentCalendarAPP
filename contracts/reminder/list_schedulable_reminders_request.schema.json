{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/reminder/list_schedulable_reminders_request.schema.json",
  "title": "ListSchedulableRemindersRequest",
  "description": "Internal scheduler query. C++ returns enabled, non-deleted pending reminders, plus scheduled status only when include_scheduled is true. Permanent failed reminders are terminal and never retried here.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["supported_methods"],
  "properties": {
    "from_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "to_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "cursor": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["remind_at", "reminder_id"],
          "properties": {
            "remind_at": {"type": "string", "format": "date-time"},
            "reminder_id": {"type": "string", "format": "uuid"}
          }
        }
      ],
      "description": "Exclusive keyset cursor ordered by (remind_at, reminder_id)."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 500
    },
    "include_scheduled": {
      "type": "boolean",
      "default": false
    },
    "supported_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "const": "popup"
      }
    }
  }
}
