{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/reminder/finalize_delivery_response.schema.json",
  "title": "FinalizeDeliveryResponse",
  "description": "Atomic finalize result. Single Reminder deliveries retain reminder/successor. Ordinary recovery summaries expose batch-only bulk effects. Anniversary catch-up exposes the complete covered Reminder set and each generated yearly successor without fabricating per-member Notification attempts.",
  "x-contract-version": 2,
  "x-anniversary-reminder-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["notification", "reminder", "successor", "covered_reminders", "successors", "recovery_batch", "idempotent_replay"],
  "properties": {
    "notification": {"$ref": "https://excellent-calendar.local/contracts/notification/notification_response.schema.json"},
    "reminder": {
      "oneOf": [
        {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_response.schema.json"},
        {"type": "null"}
      ]
    },
    "successor": {
      "oneOf": [
        {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_response.schema.json"},
        {"type": "null"}
      ]
    },
    "covered_reminders": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_response.schema.json"}
    },
    "successors": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_response.schema.json"}
    },
    "recovery_batch": {
      "oneOf": [
        {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_recovery_batch_response.schema.json"},
        {"type": "null"}
      ]
    },
    "idempotent_replay": {"type": "boolean"}
  },
  "oneOf": [
    {
      "title": "SingleReminderFinalize",
      "properties": {
        "notification": {"properties": {"kind": {"const": "reminder"}}, "required": ["kind"]},
        "reminder": {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_response.schema.json"},
        "covered_reminders": {"maxItems": 0}, "successors": {"maxItems": 0}
      }
    },
    {
      "title": "OrdinaryRecoverySummaryFinalize",
      "properties": {
        "notification": {"properties": {"kind": {"const": "recovery_summary"}}, "required": ["kind"]},
        "reminder": {"type": "null"}, "successor": {"type": "null"},
        "covered_reminders": {"maxItems": 0}, "successors": {"maxItems": 0},
        "recovery_batch": {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_recovery_batch_response.schema.json"}
      }
    },
    {
      "title": "AnniversaryCatchUpFinalize",
      "properties": {
        "notification": {"properties": {"kind": {"const": "anniversary_catch_up"}}, "required": ["kind"]},
        "reminder": {"type": "null"}, "successor": {"type": "null"},
        "covered_reminders": {"minItems": 1, "maxItems": 5},
        "recovery_batch": {"$ref": "https://excellent-calendar.local/contracts/reminder/reminder_recovery_batch_response.schema.json"}
      },
      "x-finalize-invariants": [
        "covered_reminders contains exactly notification.covered_reminder_ids in that order.",
        "For outcome sent, every covered Reminder is sent and fulfillment_delivery_id equals notification.delivery_id.",
        "successors contains at most one future Reminder per recurring template and is empty for retryable failure."
      ]
    }
  ]
}
