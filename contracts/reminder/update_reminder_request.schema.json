{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/reminder/update_reminder_request.schema.json",
  "title": "UpdateReminderRequest",
  "description": "Partial update for an ordinary one-time Reminder. Recurring Event template changes must use event.update and create a new recurrence revision.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["reminder_id"],
  "properties": {
    "reminder_id": {"type": "string", "format": "uuid"},
    "target_type": {"type": "string", "enum": ["event", "habit", "anniversary"]},
    "target_id": {"type": "string", "format": "uuid"},
    "remind_at": {"type": ["string", "null"], "format": "date-time"},
    "advance_minutes": {"type": ["integer", "null"], "minimum": 0},
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["ring", "popup", "wechat"]}
    },
    "message": {"type": ["string", "null"]},
    "source": {
      "type": "string",
      "enum": ["manual", "auto", "ai_extraction", "sync", "import", "wechat"]
    }
  }
}
