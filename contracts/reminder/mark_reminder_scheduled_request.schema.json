{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/reminder/mark_reminder_scheduled_request.schema.json",
  "title": "MarkReminderScheduledRequest",
  "description": "Internal Kotlin-to-C++ payload used after Kotlin successfully registers a reminder with Android AlarmManager or another delivery channel.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reminder_id",
    "scheduled_at"
  ],
  "properties": {
    "reminder_id": {
      "type": "string",
      "format": "uuid"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
