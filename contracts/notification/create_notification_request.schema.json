{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/notification/create_notification_request.schema.json",
  "title": "CreateNotificationRequest",
  "description": "Internal Kotlin-to-C++ request for recording one Android popup delivery attempt. Successful one-time Reminder delivery should normally use reminder.consume_after_delivery instead.",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reminder_id",
    "target_type",
    "target_id",
    "method",
    "title",
    "planned_at",
    "status"
  ],
  "properties": {
    "reminder_id": {
      "type": "string",
      "minLength": 1
    },
    "target_type": {
      "type": "string",
      "enum": ["event", "habit", "anniversary"]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "const": "popup"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": ["string", "null"]
    },
    "planned_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["sent", "failed"]
    },
    "failure_reason": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "sent" } },
        "required": ["status"]
      },
      "then": {
        "required": ["sent_at"],
        "properties": {
          "sent_at": { "type": "string", "format": "date-time" },
          "failure_reason": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "required": ["failure_reason"],
        "properties": {
          "failure_reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
