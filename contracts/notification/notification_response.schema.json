{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/notification/notification_response.schema.json",
  "title": "NotificationResponse",
  "description": "Transport representation of a delivered or attempted notification log. Notification is not scanned for future reminder scheduling.",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target_type",
    "target_id",
    "method",
    "title",
    "planned_at",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "reminder_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "target_type": {
      "type": "string",
      "enum": [
        "event",
        "habit",
        "anniversary",
        "dated_message"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "ring",
        "popup",
        "wechat"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": [
        "string",
        "null"
      ]
    },
    "planned_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "cancelled"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
