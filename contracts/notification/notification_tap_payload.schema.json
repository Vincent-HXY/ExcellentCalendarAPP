{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/notification/notification_tap_payload.schema.json",
  "title": "NotificationTapPayload",
  "description": "Opened notification payload. It preserves every prepared identity field and adds opened_at. A deleted Anniversary remains the real target; detail lookup returns ANNIVERSARY_TARGET_DELETED instead of a fabricated projection.",
  "x-contract-version": 2,
  "x-anniversary-reminder-revision": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["notification_id", "delivery_id", "delivery_attempt_id", "kind", "reminder_id", "recovery_batch_id", "target_type", "target_id", "occurrence_key", "route", "opened_at"],
  "properties": {
    "notification_id": {"type": "string", "format": "uuid"},
    "delivery_id": {"type": "string", "format": "uuid"},
    "delivery_attempt_id": {"type": "string", "format": "uuid"},
    "kind": {"type": "string", "enum": ["reminder", "recovery_summary", "anniversary_catch_up"]},
    "reminder_id": {"type": ["string", "null"], "format": "uuid"},
    "recovery_batch_id": {"type": ["string", "null"], "format": "uuid"},
    "target_type": {"type": "string", "enum": ["event", "habit", "anniversary", "reminder_recovery_batch"]},
    "target_id": {"type": "string", "format": "uuid"},
    "occurrence_key": {"type": ["string", "null"], "format": "uuid"},
    "route": {"type": ["string", "null"]},
    "opened_at": {"type": "string", "format": "date-time"}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "reminder"}, "reminder_id": {"type": "string", "format": "uuid"}, "target_type": {"enum": ["event", "habit", "anniversary"]}}, "allOf": [{"if": {"properties": {"target_type": {"const": "anniversary"}}, "required": ["target_type"]}, "then": {"properties": {"occurrence_key": {"type": "string", "format": "uuid"}}}}]},
    {"properties": {"kind": {"const": "recovery_summary"}, "reminder_id": {"type": "null"}, "recovery_batch_id": {"type": "string", "format": "uuid"}, "target_type": {"const": "reminder_recovery_batch"}, "occurrence_key": {"type": "null"}}},
    {"properties": {"kind": {"const": "anniversary_catch_up"}, "reminder_id": {"type": "null"}, "recovery_batch_id": {"type": "string", "format": "uuid"}, "target_type": {"const": "anniversary"}, "occurrence_key": {"type": "string", "format": "uuid"}, "route": {"const": "anniversary.detail"}}}
  ]
}
