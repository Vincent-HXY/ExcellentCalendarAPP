{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/preferences/update_preferences_request.schema.json",
  "title": "SyncV1 update_preferences_request",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "expected_active_route_revision",
    "expected_preferences_revision",
    "patch"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_preferences_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "patch": {
      "$ref": "https://excellent-calendar.local/contracts/sync/v1/user_preferences_patch.schema.json"
    }
  }
}
