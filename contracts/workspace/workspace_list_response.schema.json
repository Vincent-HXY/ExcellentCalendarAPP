{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/workspace/workspace_list_response.schema.json",
  "title": "SyncV1 workspace_list_response",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "active_route_revision",
    "workspaces"
  ],
  "properties": {
    "active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_id",
          "workspace_kind",
          "is_active",
          "is_unlockable"
        ],
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "workspace_kind": {
            "enum": [
              "local",
              "account"
            ]
          },
          "is_active": {
            "type": "boolean"
          },
          "is_unlockable": {
            "const": true
          }
        }
      }
    }
  }
}
