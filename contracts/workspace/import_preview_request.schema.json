{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/workspace/import_preview_request.schema.json",
  "title": "SyncV1 import_preview_request",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "expected_active_route_revision",
    "source_workspace_id",
    "target_workspace_id",
    "predecessor_lineage_id"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "predecessor_lineage_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
