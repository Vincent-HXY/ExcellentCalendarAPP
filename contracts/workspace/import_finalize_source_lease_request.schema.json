{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/workspace/import_finalize_source_lease_request.schema.json",
  "title": "SyncV1 import_finalize_source_lease_request",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-10",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_workspace_id",
    "source_epoch",
    "import_lineage_id",
    "protected_owner_binding_digest",
    "expected_source_lease_revision",
    "proof"
  ],
  "properties": {
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "import_lineage_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "protected_owner_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_source_lease_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "server_abandon",
            "terminal_local_range_receipt_hash"
          ],
          "properties": {
            "kind": {
              "const": "prepublish_abandon_range_terminal"
            },
            "server_abandon": {
              "$ref": "https://excellent-calendar.local/contracts/sync/import_abandon_response.schema.json"
            },
            "terminal_local_range_receipt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "server_abandon",
            "crypto_destroy_final_receipt_hash"
          ],
          "properties": {
            "kind": {
              "const": "prepublish_abandon_crypto_destroyed"
            },
            "server_abandon": {
              "$ref": "https://excellent-calendar.local/contracts/sync/import_abandon_response.schema.json"
            },
            "crypto_destroy_final_receipt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "guest_receipt",
            "native_completed_receipt_hash",
            "server_confirmation"
          ],
          "properties": {
            "kind": {
              "const": "cleanup_completed"
            },
            "guest_receipt": {
              "$ref": "https://excellent-calendar.local/contracts/sync/guest_import_cleanup_receipt.schema.json"
            },
            "native_completed_receipt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "server_confirmation": {
              "$ref": "https://excellent-calendar.local/contracts/sync/import_cleanup_confirm_response.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "owner_bound_account_deleted_proof",
            "deletion_receipt_hash"
          ],
          "properties": {
            "kind": {
              "const": "account_deleted"
            },
            "owner_bound_account_deleted_proof": {
              "type": "string",
              "minLength": 16,
              "maxLength": 2048,
              "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$"
            },
            "deletion_receipt_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
