{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/workspace/import_preview_response.schema.json",
  "title": "SyncV1 import_preview_response",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-01",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "source_workspace_id",
        "target_workspace_id",
        "source_epoch",
        "preview_token",
        "proposed_import_batch_id",
        "import_lineage_id",
        "manifest",
        "warnings"
      ],
      "properties": {
        "disposition": {
          "const": "ready"
        },
        "source_workspace_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "target_workspace_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preview_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 2048,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$"
        },
        "proposed_import_batch_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "import_lineage_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "manifest": {
          "$ref": "https://excellent-calendar.local/contracts/sync/sync_import_manifest.schema.json"
        },
        "warnings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "enum": [
              "opaque_category_reference",
              "identity_remapped",
              "local_execution_history_retained"
            ]
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "source_workspace_id",
        "source_epoch",
        "recovery_handle"
      ],
      "properties": {
        "disposition": {
          "const": "previous_epoch_cleanup_pending"
        },
        "source_workspace_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recovery_handle": {
          "type": "string",
          "minLength": 16,
          "maxLength": 2048,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$"
        }
      }
    }
  ]
}
