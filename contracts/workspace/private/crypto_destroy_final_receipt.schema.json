{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/workspace/private/crypto_destroy_final_receipt.schema.json",
  "title": "SyncV1 crypto_destroy_final_receipt",
  "x-contract-domain": "android_private",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-08,IMP-10;8.2;13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "account_id",
    "workspace_id",
    "operation_id",
    "device_id",
    "sync_transport_generation",
    "lifecycle_revision",
    "expected_source_lease_revision",
    "protected_owner_binding_digest",
    "source_workspace_id",
    "source_epoch",
    "import_lineage_id",
    "import_batch_id",
    "manifest_hash",
    "account_key_identity_hash",
    "state",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "account_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sync_transport_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lifecycle_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_source_lease_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "protected_owner_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "import_lineage_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "import_batch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "account_key_identity_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "const": "final"
    },
    "reason": {
      "enum": [
        "clear_rebuild",
        "logout_destroy",
        "retention_expired",
        "device_revoked",
        "security_termination"
      ]
    }
  },
  "x-owner": "Kotlin WorkspaceLifecycle / private persistence; diagnostics safe projection only",
  "x-sensitive": true,
  "x-exposure": "kotlin_local_only_never_HTTP_MethodChannel_EventChannel_or_JNI"
}
