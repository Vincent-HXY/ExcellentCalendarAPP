{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/calendar/calendar_anniversary_item.schema.json",
  "title": "CalendarAnniversaryItem",
  "description": "One date-only Anniversary occurrence on the selected date. It does not carry a UTC occurrence instant, Event recurrence revision, completion state, or localized anniversary wording.",
  "x-contract-version": 2,
  "x-calendar-view-revision": 1,
  "x-implementation-status": "integrated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anniversary_id",
    "occurrence_key",
    "occurrence_date",
    "source_date",
    "title",
    "is_repeating",
    "years_elapsed",
    "importance",
    "has_active_reminder"
  ],
  "properties": {
    "anniversary_id": {"type": "string", "format": "uuid"},
    "occurrence_key": {"type": "string", "format": "uuid"},
    "occurrence_date": {"type": "string", "format": "date"},
    "source_date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "is_repeating": {"type": "boolean"},
    "years_elapsed": {"type": "integer", "minimum": 0},
    "importance": {
      "type": ["string", "null"],
      "enum": ["unimportant_noturgent", "important_noturgent", "unimportant_urgent", "important_urgent", null]
    },
    "has_active_reminder": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"is_repeating": {"const": false}}, "required": ["is_repeating"]},
      "then": {"properties": {"years_elapsed": {"const": 0}}}
    }
  ]
}
