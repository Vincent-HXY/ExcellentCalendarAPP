{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/search/search_index_response.schema.json",
  "title": "SearchIndexResponse",
  "description": "Planned transport representation of a rebuildable search acceleration record. This is not the Search Query result contract and does not prove that a production index writer or FTS store exists.",
  "x-contract-version": 2,
  "x-search-contract-revision": 2,
  "x-implementation-status": "planned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target_type",
    "target_id",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "target_type": {
      "type": "string",
      "enum": [
        "event",
        "habit",
        "anniversary"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "title_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "body_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Derived stable Category reference used for structured filtering. It remains an opaque string so active Event v2 readers preserve legacy non-UUID category references."
    },
    "category_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Rebuildable display/full-text redundancy. It is never the structured Category filter key."
    },
    "occur_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "occur_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Derived user-local date. It is never encoded as a UTC-midnight occur_at value."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "occur_at": {"type": "string"},
          "occur_date": {"type": "string"}
        },
        "required": ["occur_at", "occur_date"]
      }
    }
  ]
}
