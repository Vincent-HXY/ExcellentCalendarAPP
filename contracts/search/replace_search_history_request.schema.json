{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/search/replace_search_history_request.schema.json",
  "title": "ReplaceSearchHistoryRequest",
  "description": "Atomically replaces the complete device-local ordered history when expected_revision still matches. Items must already be canonical display keywords returned by Search normalization.",
  "x-contract-version": 2,
  "x-search-contract-revision": 2,
  "x-implementation-status": "integrated",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "items"],
  "properties": {
    "expected_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "items": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  }
}
