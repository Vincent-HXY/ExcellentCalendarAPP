{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_bootstrap_request.schema.json",
  "title": "SyncV1 sync_bootstrap_request",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/6.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "device_id",
    "sync_transport_generation",
    "bootstrap_cursor",
    "download_limit"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sync_transport_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bootstrap_cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 2048,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$"
    },
    "download_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  }
}
