{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/backend_sync_conflict_detail_response.schema.json",
  "title": "SyncV1 backend_sync_conflict_detail_response",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.5,8,12",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "const": "unresolved"
        },
        "detail": {
          "$ref": "https://excellent-calendar.local/contracts/sync/sync_conflict_detail.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "resolution_mode",
        "resulting_entity_version",
        "effect_change_group_id",
        "effect_group_last_server_sequence"
      ],
      "properties": {
        "status": {
          "const": "resolved"
        },
        "summary": {
          "allOf": [
            {
              "$ref": "https://excellent-calendar.local/contracts/sync/backend_sync_conflict_summary.schema.json"
            },
            {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              }
            }
          ]
        },
        "resolution_mode": {
          "enum": [
            "keep_local",
            "keep_remote",
            "per_field",
            "manual_edit"
          ]
        },
        "resulting_entity_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "effect_change_group_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "effect_group_last_server_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  ]
}
