{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_sequence_recovery_bundle.schema.json",
  "title": "SyncV1 sync_sequence_recovery_bundle",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/6.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sync_transport_generation",
    "highest_client_sequence",
    "next_client_sequence",
    "client_confirmed_through",
    "client_sequence_exhausted"
  ],
  "properties": {
    "sync_transport_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "highest_client_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "next_client_sequence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "client_confirmed_through": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "client_sequence_exhausted": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "properties": {
        "highest_client_sequence": {
          "maximum": 9007199254740990
        },
        "client_sequence_exhausted": {
          "const": false
        },
        "next_client_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "properties": {
        "highest_client_sequence": {
          "const": 9007199254740991
        },
        "client_sequence_exhausted": {
          "const": true
        },
        "next_client_sequence": {
          "type": "null"
        }
      }
    }
  ]
}
