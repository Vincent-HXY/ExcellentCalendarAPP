{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_import_publish_marker.schema.json",
  "title": "SyncV1 sync_import_publish_marker",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/6.3,7.6/IMP-04",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "import_publish_group_id",
    "import_lineage_id",
    "import_batch_id",
    "source_workspace_id",
    "source_epoch",
    "manifest_hash",
    "mapping_digest",
    "begin_server_sequence",
    "commit_server_sequence",
    "total_chunk_count",
    "total_item_count",
    "publish_digest",
    "snapshot_provenance_digest",
    "snapshot_provenance_count"
  ],
  "properties": {
    "kind": {
      "const": "import_publish_marker"
    },
    "import_publish_group_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "import_lineage_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "import_batch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "begin_server_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "commit_server_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "total_chunk_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_item_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "publish_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_provenance_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
