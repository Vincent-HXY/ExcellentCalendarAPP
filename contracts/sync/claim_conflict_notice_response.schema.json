        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "$ref": "https://excellent-calendar.local/contracts/sync/sync_status_response.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "notice_id",
        "notice_sequence",
        "count",
        "status"
      ],
      "properties": {
        "disposition": {
          "const": "no_longer_actionable"
        },
        "notice_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "notice_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "count": {
          "const": 0
        },
        "status": {
          "$ref": "https://excellent-calendar.local/contracts/sync/sync_status_response.schema.json"
        }
