{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/diagnostic_export_payload.schema.json",
  "title": "SyncV1 diagnostic_export_payload",
  "x-contract-domain": "android_private",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-08,IMP-10;8.2;13",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "native",
    "android_api_bucket",
    "transport_state",
    "work_pending",
    "network_available"
  ],
