{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/import_abandon_request.schema.json",
  "title": "SyncV1 import_abandon_request",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-08",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "device_id",
    "sync_transport_generation",
    "import_lineage_id",
    "import_batch_id",
    "source_workspace_id",
    "source_epoch",
    "origin_device_id",
    "origin_sync_transport_generation",
    "begin_client_sequence",
    "terminal_client_sequence",
    "manifest",
    "predecessor_batch_id",
    "expected_import_revision",
    "reason"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sync_transport_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "import_lineage_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "import_batch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "origin_device_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "origin_sync_transport_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "begin_client_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "terminal_client_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "manifest": {
      "$ref": "https://excellent-calendar.local/contracts/sync/sync_import_manifest.schema.json"
    },
    "predecessor_batch_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_import_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "enum": [
        "user_cancelled",
        "privacy_destroy",
        "capacity_rejected"
      ]
    }
  }
}
