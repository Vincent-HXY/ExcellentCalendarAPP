{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_change_group.schema.json",
  "title": "SyncV1 sync_change_group",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/6.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "change_group_id",
    "server_sequence",
    "payload_hash",
    "entity_changes",
    "conflict_deltas"
  ],
  "properties": {
    "kind": {
      "const": "change_group"
    },
    "change_group_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "server_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entity_changes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "https://excellent-calendar.local/contracts/sync/sync_fact_after_image.schema.json"
          },
          {
            "$ref": "https://excellent-calendar.local/contracts/sync/sync_tombstone.schema.json"
          },
          {
            "$ref": "https://excellent-calendar.local/contracts/sync/sync_deleted_entity_anchor.schema.json"
          }
        ]
      }
    },
    "conflict_deltas": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "https://excellent-calendar.local/contracts/sync/sync_conflict_delta.schema.json"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "entity_changes": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "conflict_deltas": {
          "minItems": 1
        }
      }
    }
  ]
}
