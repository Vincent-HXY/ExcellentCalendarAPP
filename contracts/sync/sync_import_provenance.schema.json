{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_import_provenance.schema.json",
  "title": "SyncV1 sync_import_provenance",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-05,6.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "import_lineage_id",
    "source_workspace_id",
    "source_epoch",
    "source_target_type",
    "source_id"
  ],
  "properties": {
    "import_lineage_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_target_type": {
      "enum": [
        "category",
        "event",
        "event_recurrence",
        "event_occurrence_state",
        "anniversary",
        "anniversary_recurrence",
        "habit",
        "habit_recurrence",
        "habit_check_in",
        "user_preferences",
        "account_profile",
        "reminder_intent"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
