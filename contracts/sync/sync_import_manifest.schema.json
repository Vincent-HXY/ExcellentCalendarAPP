{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_import_manifest.schema.json",
  "title": "SyncV1 sync_import_manifest",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.1,7.6/IMP-01,IMP-11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_workspace_id",
    "source_epoch",
    "source_snapshot_hash",
    "target_counts",
    "portable_preferences_count",
    "total_item_count",
    "total_canonical_bytes",
    "mapping_digest",
    "manifest_hash"
  ],
  "properties": {
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "event",
        "event_recurrence",
        "event_occurrence_state",
        "anniversary",
        "anniversary_recurrence",
        "habit",
        "habit_recurrence",
        "habit_check_in",
        "reminder_intent"
      ],
      "properties": {
        "category": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event_recurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event_occurrence_state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "anniversary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "anniversary_recurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "habit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "habit_recurrence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "habit_check_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reminder_intent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "portable_preferences_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "total_item_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_canonical_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mapping_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
