{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner_type",
    "owner_id",
    "is_enabled",
    "templates"
  ],
  "properties": {
    "owner_type": {
      "const": "anniversary"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "is_enabled": {
      "type": "boolean"
    },
    "templates": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "advance_days",
          "local_time",
          "timezone_mode",
          "method",
          "is_enabled"
        ],
        "properties": {
          "advance_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "local_time": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "timezone_mode": {
            "const": "follow_device"
          },
          "method": {
            "const": "popup"
          },
          "is_enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/v1/reminder_intent_anniversary_fact.schema.json",
  "title": "SyncV1 reminder_intent_anniversary fact",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.2,7.7"
}
