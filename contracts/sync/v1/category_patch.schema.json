{
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": ".*\\S.*"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "color": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#[0-9A-F]{6}$"
    },
    "icon": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "sort_order": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Nullable compatibility projection constrained to the exact cross-language JSON integer range 0..9007199254740991; category.list orders null after every integer."
    }
  },
  "minProperties": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
