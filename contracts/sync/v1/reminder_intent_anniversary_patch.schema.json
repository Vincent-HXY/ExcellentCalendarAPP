{
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "is_enabled": {
      "type": "boolean"
    },
    "templates": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "advance_days",
          "local_time",
          "timezone_mode",
          "method",
          "is_enabled"
        ],
        "properties": {
          "advance_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "local_time": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "timezone_mode": {
            "const": "follow_device"
          },
          "method": {
            "const": "popup"
          },
          "is_enabled": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "minProperties": 1,
  "dependentRequired": {
    "is_enabled": [
      "templates"
    ],
    "templates": [
      "is_enabled"
    ]
  },
