{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/import_cleanup_confirm_response.schema.json",
  "title": "SyncV1 import_cleanup_confirm_response",
  "x-contract-domain": "sync_protocol",
  "x-contract-version": 1,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.6/IMP-09",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "import_lineage_id",
    "source_workspace_id",
    "source_epoch",
    "resulting_import_revision",
    "confirmed_through_published_batch_id",
    "confirmed_through_import_revision",
    "guest_cleanup_receipt_hash"
  ],
  "properties": {
    "disposition": {
      "enum": [
        "cleanup_confirmed",
        "already_cleanup_confirmed"
      ]
    },
    "import_lineage_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resulting_import_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "confirmed_through_published_batch_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "confirmed_through_import_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "guest_cleanup_receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
