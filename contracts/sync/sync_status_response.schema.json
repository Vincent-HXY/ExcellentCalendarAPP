              "next_conflict_notice_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "next_conflict_notice_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backlog_state": {
                "const": "normal"
              }
            }
          },
          "then": {
            "properties": {
              "backlog_reason_codes": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "backlog_reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
