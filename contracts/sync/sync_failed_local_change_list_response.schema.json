{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_failed_local_change_list_response.schema.json",
  "title": "SyncV1 sync_failed_local_change_list_response",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.5,8,12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "runtime_instance_id",
    "active_route_revision",
    "items",
    "next_page_token",
    "read_snapshot_revision"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtime_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "$ref": "https://excellent-calendar.local/contracts/sync/sync_failed_local_change_summary.schema.json"
      }
    },
    "next_page_token": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 2048,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048]|[A-Za-z0-9_-][AQgw])?$"
    },
    "read_snapshot_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
