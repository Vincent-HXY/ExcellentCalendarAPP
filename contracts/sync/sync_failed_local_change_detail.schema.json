{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/sync/sync_failed_local_change_detail.schema.json",
  "title": "SyncV1 sync_failed_local_change_detail",
  "x-contract-domain": "native",
  "x-contract-version": 3,
  "x-implementation-status": "planned",
  "x-release-status": "planned",
  "x-rule-anchor": "cloud-sync-02/7.5,8,12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "runtime_instance_id",
    "active_route_revision",
    "summary",
    "local_candidate",
    "manual_draft",
    "server_baseline",
    "can_edit_as_new",
    "can_discard"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runtime_instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "active_route_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "$ref": "https://excellent-calendar.local/contracts/sync/sync_failed_local_change_summary.schema.json"
    },
    "local_candidate": {
      "allOf": [
        {
          "$ref": "https://excellent-calendar.local/contracts/sync/v1/sync_fact.schema.json"
        },
        {
          "properties": {
            "target_type": {
              "enum": [
                "category",
                "event",
                "event_recurrence",
                "event_occurrence_state",
                "anniversary",
                "anniversary_recurrence",
                "habit",
                "habit_recurrence",
                "habit_check_in",
                "user_preferences",
                "reminder_intent"
              ]
            }
          }
        }
      ]
    },
    "manual_draft": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://excellent-calendar.local/contracts/sync/v1/sync_fact.schema.json"
            },
            {
              "properties": {
                "target_type": {
                  "enum": [
                    "category",
                    "event",
                    "event_recurrence",
                    "event_occurrence_state",
                    "anniversary",
                    "anniversary_recurrence",
                    "habit",
                    "habit_recurrence",
                    "habit_check_in",
                    "user_preferences",
                    "reminder_intent"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "server_baseline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "fact"
            },
            "value": {
              "allOf": [
                {
                  "$ref": "https://excellent-calendar.local/contracts/sync/v1/sync_fact.schema.json"
                },
                {
                  "properties": {
                    "target_type": {
                      "enum": [
                        "category",
                        "event",
                        "event_recurrence",
                        "event_occurrence_state",
                        "anniversary",
                        "anniversary_recurrence",
                        "habit",
                        "habit_recurrence",
                        "habit_check_in",
                        "user_preferences",
                        "reminder_intent"
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "deleted"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            }
          }
        }
      ]
    },
    "can_edit_as_new": {
      "type": "boolean"
    },
    "can_discard": {
      "type": "boolean"
    }
  }
}
