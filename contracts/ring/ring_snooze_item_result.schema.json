{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/ring/ring_snooze_item_result.schema.json",
  "title": "RingSnoozeItemResult",
  "description": "Per-item result for a ring.snooze_active batch. Partial failure remains an overall successful NativeResult and is expressed here.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_id", "status", "snoozed_reminder_id", "error"],
  "properties": {
    "delivery_id": {"type": "string", "format": "uuid"},
    "status": {"type": "string", "enum": ["succeeded", "failed"]},
    "snoozed_reminder_id": {"type": ["string", "null"], "format": "uuid"},
    "error": {
      "oneOf": [
        {"$ref": "../common/native_error.schema.json"},
        {"type": "null"}
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "succeeded"},
        "snoozed_reminder_id": {"type": "string", "format": "uuid"},
        "error": {"type": "null"}
      }
    },
    {
      "properties": {
        "status": {"const": "failed"},
        "snoozed_reminder_id": {"type": "null"},
        "error": {"$ref": "../common/native_error.schema.json"}
      }
    }
  ]
}
