{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/ai/ai_candidate_event.schema.json",
  "title": "AICandidateEvent",
  "description": "Candidate event extracted by AI and waiting for user confirmation before becoming a real event.",
  "x-contract-version": 2,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "event_request",
    "confidence"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "event_request": {
      "$ref": "../event/create_event_request.schema.json"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_category_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
