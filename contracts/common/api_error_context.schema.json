{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/common/api_error_context.schema.json",
  "title": "ApiErrorContext",
  "description": "Typed context for a backend API failure. It never contains secrets or stack traces. When present, it must carry a verification_challenge; api_error additionally requires non-null context for AUTH_EMAIL_UNVERIFIED so the client can always continue verification.",
  "x-contract-domain": "backend_api",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_challenge"],
  "properties": {
    "verification_challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "account_id",
        "purpose",
        "masked_email",
        "credential_types",
        "expires_at",
        "resend_available_at"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "format": "uuid"
        },
        "account_id": {
          "type": "string",
          "format": "uuid",
          "description": "Pending account that owns this challenge; lets the client correct the registration email before verification. The email correction endpoint requires the registration password, so this identifier is not an authorization credential."
        },
        "purpose": {
          "type": "string",
          "const": "registration_verification"
        },
        "masked_email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "credential_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["code", "link_token"]
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "resend_available_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    }
  },
  "examples": [
    {
      "verification_challenge": {
        "challenge_id": "0ca1897b-2a49-4767-b673-53d9c8b39516",
        "account_id": "3c00d043-6b7c-4eca-92fd-e22a1a6728f4",
        "purpose": "registration_verification",
        "masked_email": "u***@example.com",
        "credential_types": ["code", "link_token"],
        "expires_at": "2026-08-01T01:10:00Z",
        "resend_available_at": "2026-08-01T01:01:00Z"
      }
    }
  ]
}
