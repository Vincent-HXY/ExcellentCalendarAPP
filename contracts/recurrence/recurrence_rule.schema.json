{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/recurrence/recurrence_rule.schema.json",
  "title": "PlannedHabitRecurrenceRuleInput",
  "description": "Planned Habit recurrence input retained to avoid silently applying Event v2 anchor semantics to Habit. Event contracts must use event_recurrence_rule_input.schema.json; Anniversary V1 uses anniversary/anniversary_recurrence_rule_input.schema.json.",
  "x-contract-version": 2,
  "x-implementation-status": "planned",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "frequency",
    "interval",
    "start_at",
    "timezone"
  ],
  "properties": {
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "yearly",
        "custom"
      ]
    },
    "interval": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "days_of_week": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      }
    },
    "day_of_month": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 31
    },
    "month_of_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 12
    },
    "start_at": {
      "type": "string",
      "format": "date-time"
    },
    "end_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ]
    },
    "rrule": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reserved for future iCalendar RRULE interoperability."
    }
  }
}
