{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excellent-calendar.local/contracts/common/pagination_response.schema.json",
  "title": "PaginationResponse",
  "description": "Common pagination response fragment for list and search results.",
  "x-contract-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total",
    "page",
    "page_size",
    "has_more",
    "next_cursor"
  ],
  "properties": {
    "total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "page": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "has_more": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
